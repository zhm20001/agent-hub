{
  "name": "agent-hub",
  "description": "Agent Hub — dispatch coding agents across adapters, observe and intervene via the board",
  "version": "0.2.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhm20001/dsh-subagent-zcode.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "src",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "start": "tsx src/cli.ts",
    "test": "node scripts/test.mjs",
    "transcript": "node --import tsx src/runner/read-transcript.ts",
    "restart": "bash scripts/restart-board.sh",
    "dispatch-tickets": "node scripts/dispatch-tickets.mjs",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions",
    "prepack": "npm run build",
    "verify": "node scripts/verify.mjs verification.json"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.12",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vite": "^6.2.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agent-hub": "lib/cli.js"
  }
}
